<UserControl
    x:Class="Flow.Launcher.Plugin.WebScraper.Views.SettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="{StaticResource SettingPanelMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="{StaticResource SettingPanelItemRightMargin}">
            <TextBlock Text="Settings (JSON)" Margin="{StaticResource SettingPanelItemTopBottomMargin}"/>
            <TextBox Text="{Binding SettingsJson, Mode=TwoWay}" 
                    AcceptsReturn="True"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto"
                    Height="200"
                    FontFamily="Consolas"/>
            <Button Content="Save Settings" Width="120" Margin="{StaticResource SettingPanelItemTopBottomMargin}" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>